---
interface Props {
  icon: string;
  color: "teal" | "amber" | "violet";
  title: string;
  description: string;
  tags: string[];
}

const { icon, color, title, description, tags } = Astro.props;

// Custom line-icon paths, one per expertise pillar — kept here rather than
// an icon library so the style stays consistent with the pipeline graphic.
const ICONS: Record<string, string> = {
  platform:
    '<rect x="3" y="3" width="18" height="5" rx="1.2"/><rect x="3" y="9.5" width="18" height="5" rx="1.2"/><rect x="3" y="16" width="18" height="5" rx="1.2"/><path d="M7 8v1.5M17 8v1.5M7 14.5V16M17 14.5V16"/>',
  airflow:
    '<circle cx="5" cy="6" r="2.4"/><circle cx="19" cy="6" r="2.4"/><circle cx="12" cy="18" r="2.4"/><path d="M6.9 7.9L10.4 16.3M17.1 7.9L13.6 16.3M7.2 6h9.6"/>',
  shield:
    '<path d="M12 3l7 3.2v5.3c0 4.6-3 7.7-7 9-4-1.3-7-4.4-7-9V6.2L12 3z"/><path d="M9 12.2l2 2 4-4.2"/>',
  schema:
    '<rect x="3" y="4" width="8" height="6" rx="1.2"/><rect x="13" y="4" width="8" height="6" rx="1.2"/><rect x="8" y="14" width="8" height="6" rx="1.2"/><path d="M7 10v2.5h10V10M12 14v-1.5"/>',
  agent:
    '<path d="M9.5 12a2.7 2.7 0 012.7-2.7h1a2.7 2.7 0 012.7 2.7v0a2.7 2.7 0 01-2.7 2.7h-1"/><path d="M8.1 9.3H7a2.7 2.7 0 00-2.7 2.7v0A2.7 2.7 0 007 14.7h1.1"/><circle cx="18.5" cy="18.5" r="2.3"/><circle cx="5.5" cy="5.5" r="2"/>',
  migration:
    '<rect x="2" y="9" width="7" height="10" rx="1.2"/><path d="M4.3 12.2h2.4M4.3 15.2h2.4"/><path d="M11 14h3.2"/><path d="M12.6 12l2 2-2 2"/><path d="M21.5 18.5H16a3 3 0 01-.6-5.94A4 4 0 0122.7 14a2.7 2.7 0 01-1.2 4.5z"/>',
  coaching:
    '<circle cx="7" cy="7.5" r="3"/><path d="M2 20c0-3.2 2.4-5.8 5-5.8s5 2.6 5 5.8"/><path d="M14.5 6.5H20a1 1 0 011 1v5a1 1 0 01-1 1h-1.2l-2.3 2.2v-2.2H14.5a1 1 0 01-1-1v-5a1 1 0 011-1z"/>',
};
---

<div class="expertise-card">
  <div class={`expertise-icon ei-${color}`}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" set:html={ICONS[icon]} />
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
  <div class="tag-row">
    {tags.map((tag) => <span class="tag">{tag}</span>)}
  </div>
</div>

<style>
  .expertise-card {
    background: var(--panel); border: 1px solid var(--panel-border); border-radius: 14px; padding: 26px;
    transition: border-color .15s ease, transform .15s ease;
  }
  .expertise-card:hover { border-color: var(--teal); transform: translateY(-2px); }
  .expertise-icon {
    width: 46px; height: 46px; border-radius: 11px;
    display: flex; align-items: center; justify-content: center; margin-bottom: 18px;
  }
  .expertise-icon svg { width: 24px; height: 24px; }
  .ei-teal { background: rgba(76,217,192,0.1); } .ei-teal svg { color: var(--teal); }
  .ei-amber { background: rgba(245,166,35,0.1); } .ei-amber svg { color: var(--amber); }
  .ei-violet { background: rgba(156,140,240,0.1); } .ei-violet svg { color: var(--violet); }
  .expertise-card h3 { font-family: var(--font-display); font-size: 16.5px; font-weight: 600; margin-bottom: 10px; }
  .expertise-card p { font-size: 13.5px; color: var(--text-dim); margin-bottom: 16px; }
</style>
