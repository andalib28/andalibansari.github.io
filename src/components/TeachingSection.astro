---
import { UDEMY } from "../consts";

const instructorStats = [
  {
    icon: '<path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.8l-5.2 2.8 1-5.8-4.3-4.1 5.9-.9L12 3.5z"/>',
    value: UDEMY.instructorRating,
    label: "Instructor rating",
  },
  {
    icon: '<path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/>',
    value: UDEMY.reviews,
    label: "Reviews",
  },
  {
    icon: '<circle cx="9" cy="8" r="3"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17" cy="9" r="2.4"/><path d="M15.5 14.2c2.5.4 4.5 2.6 4.5 5.3"/>',
    value: UDEMY.students,
    label: "Students",
  },
  {
    icon: '<circle cx="12" cy="12" r="9"/><path d="M10 8.5l6 3.5-6 3.5v-7z"/>',
    value: UDEMY.courseCount,
    label: "Courses",
  },
];

const courseStats = [
  `★ ${UDEMY.course.rating}`,
  UDEMY.course.ratingsCount,
  UDEMY.course.hours,
  UDEMY.course.lectures,
  UDEMY.course.level,
];
---

<section id="teaching">
  <div class="wrap">
    <div class="sec-head">
      <div class="sec-eyebrow">// teaching</div>
      <h2 class="sec-title">Also on Udemy</h2>
      <p class="sec-sub">I teach data engineering to a global student base alongside consulting work.</p>
    </div>

    <div class="teaching-grid">
      <div class="instructor-card">
        <img src="/profile.jpg" alt="Andalib Ansari" class="instructor-photo" />
        <div class="instructor-stats">
          {instructorStats.map((stat) => (
            <div class="stat">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" set:html={stat.icon} />
              <div>
                <div class="stat-value">{stat.value}</div>
                <div class="stat-label">{stat.label}</div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <a href={UDEMY.course.url} target="_blank" rel="noopener" class="course-card">
        <div class="course-graphic">
          <img src="/course-banner.jpg" alt={UDEMY.course.title} />
        </div>
        <div class="course-body">
          <span class="course-eyebrow">Udemy Course</span>
          <h3>{UDEMY.course.title}</h3>
          <p>{UDEMY.course.tagline}</p>
          <div class="course-stat-row">
            {courseStats.map((s) => <span class="course-stat">{s}</span>)}
          </div>
          <span class="course-cta">View course on Udemy →</span>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  .teaching-grid { display: grid; grid-template-columns: 1fr; gap: 20px; }
  @media (min-width: 860px) { .teaching-grid { grid-template-columns: 0.85fr 1.15fr; } }

  .instructor-card {
    background: var(--panel); border: 1px solid var(--panel-border); border-radius: 14px;
    padding: 26px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 20px;
  }
  .instructor-photo {
    width: 96px; height: 96px; border-radius: 50%; object-fit: cover; border: 2px solid var(--teal);
  }
  .instructor-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; width: 100%; }
  .stat { display: flex; align-items: center; gap: 8px; justify-content: center; }
  .stat svg { width: 16px; height: 16px; color: var(--amber); flex-shrink: 0; }
  .stat-value { font-family: var(--font-mono); font-size: 14px; font-weight: 600; color: var(--text); text-align: left; }
  .stat-label { font-size: 10.5px; color: var(--text-dim); text-align: left; }

  .course-card {
    background: var(--panel); border: 1px solid var(--panel-border); border-radius: 14px;
    overflow: hidden; display: block; transition: border-color .15s ease, transform .15s ease;
  }
  .course-card:hover { border-color: var(--teal); transform: translateY(-2px); }

  .course-graphic {
    border-bottom: 1px solid var(--panel-border);
    overflow: hidden;
    line-height: 0;
  }
  .course-graphic img {
    width: 100%; height: auto; display: block;
    transition: transform .25s ease;
  }
  .course-card:hover .course-graphic img { transform: scale(1.03); }

  .course-body { padding: 22px; }
  .course-eyebrow {
    font-family: var(--font-mono); font-size: 11px; color: var(--teal);
    text-transform: uppercase; letter-spacing: 0.5px;
  }
  .course-body h3 { font-family: var(--font-display); font-size: 17px; font-weight: 600; margin: 8px 0 8px; }
  .course-body p { font-size: 13.5px; color: var(--text-dim); margin-bottom: 16px; }
  .course-stat-row { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; }
  .course-stat {
    font-family: var(--font-mono); font-size: 11px; color: var(--text-dim);
    border: 1px solid var(--panel-border); padding: 4px 9px; border-radius: 6px;
  }
  .course-cta { font-family: var(--font-mono); font-size: 13px; color: var(--amber); font-weight: 600; }
</style>
