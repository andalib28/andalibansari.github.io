---
import { SERVICES } from "../consts";
---

<section id="services">
  <div class="wrap">
    <div class="sec-head">
      <div class="sec-eyebrow">// engagement models</div>
      <h2 class="sec-title">Ways to work with me</h2>
    </div>
    <div class="services-grid">
      {SERVICES.map((service) => (
        <div class="service-card">
          <h3>{service.title}</h3>
          <p>{service.description}</p>
          <a href="#contact" class="service-cta">{service.cta}</a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services-grid { display: grid; grid-template-columns: 1fr; gap: 18px; }
  @media (min-width: 820px) { .services-grid { grid-template-columns: repeat(3, 1fr); } }
  .service-card { background: var(--panel); border: 1px solid var(--panel-border); border-radius: 14px; padding: 24px; }
  .service-card h3 { font-family: var(--font-display); font-size: 15.5px; font-weight: 600; margin-bottom: 8px; }
  .service-card p { font-size: 13px; color: var(--text-dim); margin-bottom: 14px; }
  .service-cta { font-family: var(--font-mono); font-size: 12.5px; color: var(--amber); font-weight: 600; }
</style>
