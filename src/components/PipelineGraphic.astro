---
// The hero diagram: raw events/batch data -> Airflow -> data quality gate ->
// modeled warehouse -> n8n/LangChain agent -> human validation -> decision.
// Kept as one component since the flow-lines, nodes, and corner circuitry
// are positionally coupled. Circuit-trace corners echo the same motif used
// on the Udemy course banner, tying the two together visually.
---

<div class="pipeline-box">
  <div class="label">// platform_to_agent.svg</div>
  <svg class="pipeline-svg" viewBox="0 0 380 470" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <radialGradient id="bgGlow" cx="50%" cy="45%" r="65%">
        <stop offset="0%" stop-color="#4CD9C0" stop-opacity="0.07"/>
        <stop offset="100%" stop-color="#4CD9C0" stop-opacity="0"/>
      </radialGradient>
      <linearGradient id="nodeTeal" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#4CD9C0" stop-opacity="0.22"/>
        <stop offset="100%" stop-color="#4CD9C0" stop-opacity="0.04"/>
      </linearGradient>
      <linearGradient id="nodeViolet" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#9C8CF0" stop-opacity="0.28"/>
        <stop offset="100%" stop-color="#9C8CF0" stop-opacity="0.08"/>
      </linearGradient>
      <linearGradient id="nodeAmber" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#F5A623" stop-opacity="0.24"/>
        <stop offset="100%" stop-color="#F5A623" stop-opacity="0.06"/>
      </linearGradient>
      <filter id="softGlow" x="-60%" y="-60%" width="220%" height="220%">
        <feGaussianBlur stdDeviation="4.5" result="blur"/>
        <feMerge>
          <feMergeNode in="blur"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>
    </defs>

    <rect x="0" y="0" width="380" height="470" fill="url(#bgGlow)"/>

    <!-- circuit-trace corner decoration, top-left -->
    <g class="circuit" transform="translate(6,6)">
      <path d="M0,18 H14 V4 H30 M6,18 V30 H20"/>
      <circle cx="30" cy="4" r="2"/>
      <circle cx="20" cy="30" r="2"/>
      <circle cx="0" cy="18" r="1.6"/>
    </g>
    <!-- circuit-trace corner decoration, bottom-right -->
    <g class="circuit" transform="translate(374,464) rotate(180)">
      <path d="M0,18 H14 V4 H30 M6,18 V30 H20"/>
      <circle cx="30" cy="4" r="2"/>
      <circle cx="20" cy="30" r="2"/>
      <circle cx="0" cy="18" r="1.6"/>
    </g>

    <path class="flow-line flow-dash" d="M60,52 C60,85 72,95 90,120"/>
    <path class="flow-line flow-dash" d="M320,52 C320,85 245,100 195,122"/>
    <path class="flow-line flow-dash" d="M143,148 C165,163 175,168 187,180"/>
    <path class="flow-line flow-dash" d="M190,207 C190,228 190,238 190,258"/>
    <path class="flow-line-alt flow-dash" d="M190,290 C190,315 190,325 190,347"/>
    <path class="flow-line-alt flow-dash" d="M188,392 C170,410 135,420 103,433"/>
    <path class="flow-line-alt flow-dash" d="M192,392 C210,410 250,420 278,433"/>

    <!-- sources -->
    <circle class="node-circle node-teal" cx="60" cy="32" r="25"/>
    <text x="60" y="36" text-anchor="middle" class="node-label">Events</text>
    <text x="60" y="66" text-anchor="middle" class="node-label" fill-opacity="0.65">stream data</text>

    <circle class="node-circle node-teal" cx="320" cy="32" r="25"/>
    <text x="320" y="36" text-anchor="middle" class="node-label">S3</text>
    <text x="320" y="66" text-anchor="middle" class="node-label" fill-opacity="0.65">batch data</text>

    <!-- Airflow orchestrator -->
    <circle class="node-circle node-amber" cx="150" cy="132" r="27"/>
    <text x="150" y="128" text-anchor="middle" class="node-label">Airflow</text>
    <text x="150" y="141" text-anchor="middle" class="node-label" fill-opacity="0.65">orchestration</text>

    <!-- DQ server -->
    <circle class="node-circle node-teal" cx="190" cy="193" r="25"/>
    <text x="190" y="189" text-anchor="middle" class="node-label">DQ Server</text>
    <text x="190" y="202" text-anchor="middle" class="node-label" fill-opacity="0.65">custom checks</text>

    <!-- Warehouse modeling -->
    <circle class="node-circle node-amber" cx="190" cy="274" r="28"/>
    <text x="190" y="270" text-anchor="middle" class="node-label">Warehouse</text>
    <text x="190" y="283" text-anchor="middle" class="node-label" fill-opacity="0.65">modeled schema</text>

    <!-- n8n + LangChain agent — the "live" node -->
    <circle class="node-circle-agent pulse" cx="190" cy="370" r="31" filter="url(#softGlow)"/>
    <text x="190" y="366" text-anchor="middle" class="node-label node-label-agent">n8n +</text>
    <text x="190" y="378" text-anchor="middle" class="node-label node-label-agent">LangChain</text>

    <!-- human validation + decision -->
    <circle class="node-circle node-teal" cx="98" cy="452" r="21"/>
    <text x="98" y="448" text-anchor="middle" class="node-label" font-size="9">HUMAN</text>
    <text x="98" y="459" text-anchor="middle" class="node-label" font-size="9" fill-opacity="0.65">validation</text>

    <circle class="node-circle-final" cx="282" cy="452" r="21" filter="url(#softGlow)"/>
    <text x="282" y="448" text-anchor="middle" class="node-label-final" font-size="9">DECISION</text>
    <text x="282" y="459" text-anchor="middle" class="node-label-final" font-size="9">shipped</text>
  </svg>
</div>

<style>
  .pipeline-box {
    background: var(--panel); border: 1px solid var(--panel-border); border-radius: 16px;
    padding: 20px; overflow: hidden;
  }
  .pipeline-box .label {
    font-family: var(--font-mono); font-size: 11px; color: var(--text-dim);
    text-transform: uppercase; letter-spacing: 1px; margin-bottom: 6px;
  }
  .pipeline-svg { width: 100%; height: auto; display: block; }

  .circuit { fill: none; stroke: var(--teal); stroke-width: 1; opacity: 0.28; }
  .circuit circle { fill: var(--teal); stroke: none; opacity: 0.5; }

  .node-label { font-family: var(--font-mono); font-size: 9.5px; fill: var(--text-dim); }
  .node-label-agent { fill: #D8D2FA; font-weight: 500; }
  .node-label-final { font-family: var(--font-mono); font-size: 10px; fill: var(--amber); font-weight: 600; }

  .flow-line { stroke: var(--teal); stroke-width: 1.4; fill: none; opacity: 0.5; stroke-linecap: round; }
  .flow-line-alt { stroke: var(--violet); stroke-width: 1.4; fill: none; opacity: 0.45; stroke-linecap: round; }
  .flow-dash { stroke-dasharray: 5 7; animation: flow 2.6s linear infinite; }
  @keyframes flow { to { stroke-dashoffset: -48; } }

  .node-circle { stroke-width: 1.3; }
  .node-teal { fill: url(#nodeTeal); stroke: var(--teal); }
  .node-amber { fill: url(#nodeAmber); stroke: var(--amber); }
  .node-circle-agent { fill: url(#nodeViolet); stroke: var(--violet); stroke-width: 1.6; }
  .node-circle-final { fill: rgba(245,166,35,0.16); stroke: var(--amber); stroke-width: 1.6; }

  .pulse { animation: pulse 2.8s ease-in-out infinite; transform-origin: 190px 370px; }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.72; transform: scale(1.04); }
  }
  @media (prefers-reduced-motion: reduce) {
    .flow-dash, .pulse { animation: none; }
  }
</style>
