---
// The hero diagram: OLTP/event/S3 sources -> Airflow orchestration -> data
// quality gate -> modeled warehouse -> splits into BI dashboards and the AI
// engineering layer -> human validation -> shipped decision.
// viewBox is sized to match the hero's actual right-column width (~480-500px)
// rather than an arbitrary canvas, so text renders at its real intended size
// instead of being shrunk by the browser's SVG scaling. A staggered opacity
// pulse ("glow") sweeps down the chain once on load and stays lit.
// // data_to_decision.svg
---

<div class="pipeline-box">
  <div class="label">// data_to_decision.svg</div>
  <svg
    class="pipeline-svg"
    viewBox="0 0 480 480"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <radialGradient id="bgGlow" cx="50%" cy="35%" r="65%">
        <stop offset="0%" stop-color="#4CD9C0" stop-opacity="0.07"></stop>
        <stop offset="100%" stop-color="#4CD9C0" stop-opacity="0"></stop>
      </radialGradient>
    </defs>

    <rect x="0" y="0" width="480" height="480" fill="url(#bgGlow)"></rect>

    <!-- sources -> Airflow -->
    <path class="pulse" style="animation-delay:.4s" d="M120,43 Q170,70 231,114"
    ></path>
    <path class="pulse" style="animation-delay:.4s" d="M245,62 V108"></path>
    <path class="pulse" style="animation-delay:.4s" d="M370,43 Q320,70 259,114"
    ></path>
    <!-- Airflow -> DQ -->
    <path class="pulse" style="animation-delay:1.2s" d="M245,152 V167"></path>
    <!-- DQ -> Warehouse -->
    <path class="pulse" style="animation-delay:2s" d="M245,207 V223"></path>
    <!-- Warehouse -> BI / AI (branch) -->
    <path class="pulse" style="animation-delay:2.8s" d="M245,267 V281 H166 V295"
    ></path>
    <path
      class="pulse flow-violet"
      style="animation-delay:2.8s"
      d="M245,267 V281 H324 V287"></path>
    <!-- AI -> Human / Decision -->
    <path
      class="pulse flow-violet"
      style="animation-delay:3.6s"
      d="M324,347 V360 H245 V386"></path>
    <path
      class="pulse flow-violet"
      style="animation-delay:3.6s"
      d="M324,347 V360 H403 V386"></path>

    <!-- OLTP -->
    <g class="pulse" style="animation-delay:0s">
      <circle class="node-teal" cx="101" cy="43" r="19"></circle>
      <rect x="93" y="35" width="16" height="16" rx="2" class="icon-teal"
      ></rect>
      <path d="M93,41 H109 M93,47 H109" class="icon-teal"></path>
    </g>
    <text x="101" y="73" text-anchor="middle" class="t">OLTP</text>
    <text x="101" y="88" text-anchor="middle" class="ts">transactional DB</text>

    <!-- Events -->
    <g class="pulse" style="animation-delay:0s">
      <circle class="node-teal" cx="245" cy="43" r="19"></circle>
      <path
        d="M248,35 L241,45 L245,45 L243,51 L250,40 L246,40 Z"
        fill="var(--teal)"
        stroke="none"></path>
    </g>
    <text x="245" y="73" text-anchor="middle" class="t">Events</text>
    <text x="245" y="88" text-anchor="middle" class="ts">stream data</text>

    <!-- S3 -->
    <g class="pulse" style="animation-delay:0s">
      <circle class="node-teal" cx="389" cy="43" r="19"></circle>
      <circle cx="384" cy="41" r="3.6" class="icon-teal"></circle>
      <circle cx="390" cy="39" r="4.6" class="icon-teal"></circle>
      <circle cx="395" cy="42" r="3.2" class="icon-teal"></circle>
      <rect
        x="381"
        y="42"
        width="17"
        height="4.5"
        rx="2.2"
        fill="var(--panel)"
        stroke="var(--teal)"
        stroke-width="1.1"></rect>
    </g>
    <text x="389" y="73" text-anchor="middle" class="t">S3</text>
    <text x="389" y="88" text-anchor="middle" class="ts">batch data</text>

    <!-- Airflow -->
    <g class="pulse" style="animation-delay:.8s">
      <circle class="node-amber" cx="245" cy="130" r="22"></circle>
      <rect x="236" y="123" width="5" height="5" rx="1" fill="var(--amber)"
      ></rect>
      <rect x="249" y="123" width="5" height="5" rx="1" fill="var(--amber)"
      ></rect>
      <rect x="242" y="133" width="6" height="6" rx="1" class="icon-amber"
      ></rect>
      <path d="M240,128 L243,133 M251,128 L248,133" class="icon-amber"></path>
    </g>
    <text x="277" y="127" class="t">Airflow</text>
    <text x="277" y="141" class="ts">orchestration</text>

    <!-- DQ server -->
    <g class="pulse" style="animation-delay:1.6s">
      <circle class="node-teal" cx="245" cy="187" r="20"></circle>
      <path
        d="M245,177 L253,180 V188 C253,194 249,197 245,199 C241,197 237,194 237,188 V180 Z"
        class="icon-teal"></path>
      <path
        d="M241,187 L244,190 L250,182"
        class="icon-teal"
        stroke-linecap="round"></path>
    </g>
    <text x="275" y="184" class="t">DQ server</text>
    <text x="275" y="198" class="ts">custom checks</text>

    <!-- Warehouse (isometric cube) -->
    <g class="pulse" style="animation-delay:2.4s">
      <circle class="node-amber" cx="245" cy="245" r="22"></circle>
      <path d="M245,234 L253,239 L245,244 L237,239 Z" class="icon-amber"></path>
      <path
        d="M237,239 L237,250 L245,255 L245,244 Z"
        fill="var(--amber)"
        fill-opacity="0.15"
        stroke="var(--amber)"
        stroke-width="1.2"></path>
      <path
        d="M253,239 L253,250 L245,255 L245,244 Z"
        fill="var(--amber)"
        fill-opacity="0.32"
        stroke="var(--amber)"
        stroke-width="1.2"></path>
    </g>
    <text x="277" y="242" class="t">Warehouse</text>
    <text x="277" y="256" class="ts">modeled schema</text>

    <!-- BI branch -->
    <g class="pulse" style="animation-delay:3.2s">
      <circle class="node-teal" cx="166" cy="317" r="22"></circle>
      <rect x="158" y="314" width="4" height="7" fill="var(--teal)"></rect>
      <rect x="164" y="309" width="4" height="12" fill="var(--teal)"></rect>
      <rect x="170" y="304" width="4" height="17" fill="var(--teal)"></rect>
    </g>
    <text x="166" y="353" text-anchor="middle" class="t"
      >BI &amp; dashboards</text
    >
    <text x="166" y="367" text-anchor="middle" class="ts"
      >reports &amp; KPIs</text
    >

    <!-- AI Engineering branch (emphasized) -->
    <g class="pulse" style="animation-delay:3.2s">
      <circle
        cx="324"
        cy="317"
        r="30"
        fill="none"
        stroke="var(--violet)"
        stroke-width="1"
        opacity="0.3"></circle>
      <circle class="node-violet" cx="324" cy="317" r="24"></circle>
      <rect x="317" y="310" width="14" height="14" rx="3" class="icon-violet"
      ></rect>
      <path
        d="M320,310 V306 M328,310 V306 M320,324 V328 M328,324 V328 M317,314 H313 M317,320 H313 M331,314 H335 M331,320 H335"
        class="icon-violet"></path>
    </g>
    <text x="364" y="314" class="t-ai">AI Engineering</text>
    <text x="364" y="329" class="ts">agentic workflows</text>

    <!-- Human validation -->
    <g class="pulse" style="animation-delay:4s">
      <circle class="node-teal" cx="245" cy="403" r="17"></circle>
      <circle cx="245" cy="397" r="3.5" class="icon-teal"></circle>
      <path d="M236,411 L245,402 L254,411 Z" class="icon-teal"></path>
    </g>
    <text x="245" y="432" text-anchor="middle" class="t">Human</text>
    <text x="245" y="446" text-anchor="middle" class="ts">validation</text>

    <!-- Decision shipped -->
    <g class="pulse" style="animation-delay:4s">
      <circle
        cx="403"
        cy="403"
        r="17"
        fill="var(--amber)"
        fill-opacity="0.16"
        stroke="var(--amber)"
        stroke-width="1.5"></circle>
      <path
        d="M396,403 L401,409 L411,396"
        fill="none"
        stroke="var(--amber)"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </g>
    <text x="403" y="432" text-anchor="middle" class="t-decision">Decision</text
    >
    <text x="403" y="446" text-anchor="middle" class="ts-decision">shipped</text
    >
  </svg>
</div>

<style>
  .pipeline-box {
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-radius: 16px;
    padding: 20px;
    overflow: hidden;
  }
  .pipeline-box .label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 6px;
  }
  .pipeline-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .t {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    fill: var(--text);
  }
  .ts {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--text-dim);
  }
  .t-ai {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    fill: #d8d2fa;
  }
  .t-decision {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    fill: var(--amber);
  }
  .ts-decision {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--amber);
    opacity: 0.8;
  }

  .node-teal {
    fill: var(--teal);
    fill-opacity: 0.12;
    stroke: var(--teal);
    stroke-width: 1.4;
  }
  .node-amber {
    fill: var(--amber);
    fill-opacity: 0.12;
    stroke: var(--amber);
    stroke-width: 1.4;
  }
  .node-violet {
    fill: var(--violet);
    fill-opacity: 0.18;
    stroke: var(--violet);
    stroke-width: 1.6;
  }
  .icon-teal {
    fill: none;
    stroke: var(--teal);
    stroke-width: 1.3;
  }
  .icon-amber {
    fill: none;
    stroke: var(--amber);
    stroke-width: 1.3;
  }
  .icon-violet {
    fill: none;
    stroke: var(--violet);
    stroke-width: 1.3;
  }

  path.pulse {
    fill: none;
    stroke: var(--teal);
    stroke-width: 1.3;
    stroke-dasharray: 3 4;
  }
  path.flow-violet {
    stroke: var(--violet);
  }

  @keyframes glow {
    from {
      opacity: 0.3;
    }
    to {
      opacity: 1;
    }
  }
  .pulse {
    animation: glow 0.6s ease-out forwards;
  }
  @media (prefers-reduced-motion: reduce) {
    .pulse {
      animation: none;
      opacity: 1;
    }
  }
</style>
