---
import PipelineGraphic from './PipelineGraphic.astro';
import { UDEMY } from '../consts';

const chips = [
  {
    label: 'Platform design',
    path: '<rect x="4" y="4" width="16" height="4" rx="1"/><rect x="4" y="10" width="16" height="4" rx="1"/><rect x="4" y="16" width="16" height="4" rx="1"/>',
  },
  {
    label: 'Airflow setup',
    path: '<circle cx="5" cy="6" r="2.2"/><circle cx="19" cy="6" r="2.2"/><circle cx="12" cy="18" r="2.2"/><path d="M6.8 7.6L10.5 16M17.2 7.6L13.5 16M7 6h10"/>',
  },
  {
    label: 'Data quality server',
    path: '<path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/>',
  },
  {
    label: 'Warehouse modeling',
    path: '<rect x="3" y="4" width="8" height="6" rx="1"/><rect x="13" y="4" width="8" height="6" rx="1"/><rect x="8" y="14" width="8" height="6" rx="1"/><path d="M7 10v2h10v-2M12 14v-2"/>',
  },
  {
    label: 'n8n + LangChain AI apps',
    path: '<path d="M9 12a3 3 0 013-3h1a3 3 0 013 3v0a3 3 0 01-3 3h-1"/><path d="M8 9H7a3 3 0 00-3 3v0a3 3 0 003 3h1"/><circle cx="18" cy="18" r="2"/>',
  },
];
---

<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <div class="identity-row">
        <img src="/profile.jpg" alt="Andalib Ansari" class="avatar-img" />
        <div>
          <div class="eyebrow">
            <span class="dot"></span> DATA PLATFORM &amp; AI ENGINEERING
          </div>
          <div class="name-line">Andalib Ansari</div>
        </div>
      </div>

      <h1>
        End-to-end data platforms, <span class="accent"
          >wired for AI agents.</span
        >
      </h1>
      <p class="lede">
        I build the full path from raw events to a trusted warehouse -
        orchestration, quality gates, modeling - then wire agentic AI on top of
        it
      </p>
      <div class="cta-row">
        <a href="#expertise" class="btn btn-primary">See my expertise →</a>
        <a href="#contact" class="btn btn-ghost">Get in touch</a>
      </div>

      <p class="trust-line">
        Also teaches data engineering to <strong
          >{UDEMY.students} students</strong
        > on Udemy —
        <a href="#teaching">see the course ↓</a>
      </p>

      <div class="chip-row">
        {
          chips.map((chip) => (
            <div class="chip">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                set:html={chip.path}
              />
              {chip.label}
            </div>
          ))
        }
      </div>
    </div>

    <PipelineGraphic />
  </div>
</section>

<style>
  .hero {
    padding-top: 72px;
    padding-bottom: 46px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 44px;
    align-items: center;
  }
  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: 1.05fr 0.95fr;
    }
  }

  .identity-row {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 26px;
  }
  .avatar-img {
    width: 108px;
    height: 108px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--teal);
    display: block;
    flex-shrink: 0;
  }
  .name-line {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 600;
    margin-top: 6px;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--amber);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .eyebrow .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--amber);
    box-shadow: 0 0 8px var(--amber);
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 4.4vw, 3.05rem);
    line-height: 1.1;
    letter-spacing: -0.5px;
    margin-bottom: 16px;
  }
  h1 .accent {
    color: var(--teal);
  }
  .lede {
    font-size: 16px;
    color: var(--text-dim);
    max-width: 54ch;
    margin-bottom: 26px;
  }
  .cta-row {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 18px;
  }

  .trust-line {
    font-size: 13px;
    color: var(--text-dim);
    margin-bottom: 26px;
  }
  .trust-line strong {
    color: var(--text);
    font-weight: 600;
  }
  .trust-line a {
    color: var(--teal);
    font-family: var(--font-mono);
    font-size: 12.5px;
  }
  .trust-line a:hover {
    text-decoration: underline;
  }

  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }
  .chip {
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--text-dim);
    border: 1px solid var(--panel-border);
    padding: 7px 11px;
    border-radius: 20px;
  }
  .chip svg {
    width: 13px;
    height: 13px;
    color: var(--teal);
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .avatar-img {
      width: 84px;
      height: 84px;
    }
  }
</style>
