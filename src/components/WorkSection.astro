---
import { SELECTED_WORK } from "../consts";
---

<section id="work">
  <div class="wrap">
    <div class="sec-head">
      <div class="sec-eyebrow">// proof</div>
      <h2 class="sec-title">Selected work</h2>
      <p class="sec-sub">Employer and client names withheld where engagements are proprietary — full context available on request.</p>
    </div>
    <div class="work-grid">
      {SELECTED_WORK.map((item) => (
        <div class="work-card">
          <div class="work-domain">{item.domain}</div>
          <h4>{item.title}</h4>
          <p>{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .work-grid { display: grid; grid-template-columns: 1fr; gap: 18px; }
  @media (min-width: 760px) { .work-grid { grid-template-columns: 1fr 1fr; } }
  .work-card { background: var(--panel); border: 1px solid var(--panel-border); border-radius: var(--radius); padding: 22px; }
  .work-card .work-domain {
    font-family: var(--font-mono); font-size: 11px; color: var(--teal);
    text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 10px;
  }
  .work-card h4 { font-family: var(--font-display); font-size: 15.5px; font-weight: 600; margin-bottom: 8px; }
  .work-card p { font-size: 13.5px; color: var(--text-dim); }
</style>
